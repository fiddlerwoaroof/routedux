{
  "name": "routedux",
  "contributors": [
    {
      "name": "Maximilian Summe",
      "email": "msumme@gmail.com"
    },
    {
      "name": "Edward Langley",
      "email": "el-os@elangley.org"
    }
  ],
  "main": "dist/index.js",
  "version": "2.0.1",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.3.1 || ^19.2.4",
    "react-dom": "^18.3.1 || ^19.2.4",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1"
  },
  "dependencies": {
    "prop-types": "^15.5.10",
    "ramda": "^0.32.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.5",
    "@babel/core": "^8.0.6",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/preset-env": "^8.0.5",
    "@babel/preset-react": "^8.0.1",
    "@cfaester/enzyme-adapter-react-18": "^0.8.0",
    "babel-jest": "^30.5.1",
    "dotenv": "18.0.3",
    "dotenv-expand": "1000.0.0",
    "enzyme": "^3.10.0",
    "enzyme-to-json": "^3.6.2",
    "eslint": "^10.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "fs-extra": "11.4.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.2.0",
    "jest-pnp-resolver": "1.2.3",
    "jest-resolve": "30.5.1",
    "jest-watch-typeahead": "^3.0.1",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-app-polyfill": "^3.0.0",
    "react-dom": "^18.3.1",
    "redux": "^5.0.1"
  },
  "scripts": {
    "build": "npx babel src -d dist",
    "watch": "npx babel -w src -d dist",
    "test": "node scripts/test.js --env=jsdom",
    "buildPub": "yarn build && npm publish",
    "lint": "eslint src",
    "format": "prettier --write \"$(git rev-parse --show-toplevel)\""
  },
  "npmFileMap": [
    {
      "basePath": "/dist/",
      "files": [
        "*.js"
      ]
    }
  ],
  "babel": {
    "presets": [
      "@babel/preset-react",
      "@babel/preset-env"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost"
    },
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.d.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/tests/*.test.js"
    ],
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.js$"
    ],
    "moduleFileExtensions": [
      "js",
      "json"
    ]
  },
  "prettier": {
    "trailingComma": "es5",
    "jsxBracketSameLine": true,
    "arrowParens": "avoid"
  },
  "allowScripts": {
    "unrs-resolver@1.9.0": true,
    "core-js": false
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  }
}
